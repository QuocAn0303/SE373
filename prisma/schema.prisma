  tenantId    String?
  assetId        String
  asset          FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period         String // "YYYY-MM"
  amount         Decimal    @db.Decimal(15, 2)
  journalEntryId String?
  postedAt       DateTime?

  @@unique([assetId, period])
  @@map("depreciation_schedules")
@@index([tenantId])
}

// ==================== VENDORS / SUPPLIERS ====================

// SRM: phân loại vendor theo ma trận Kraljic (Mục 5)
enum KraljicCategory {
  STRATEGIC
  LEVERAGE
  BOTTLENECK
  ROUTINE
}

model Vendor {
  id            String   @id @default(uuid())
  tenantId    String?
  code          String   @unique
  name          String
  taxCode       String? // MST
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  paymentTerms  Int      @default(30) // số ngày công nợ
  totalDebt     Decimal  @default(0) @db.Decimal(15, 2) // tổng còn nợ

  // SRM: Kraljic + Vendor Scorecard (Mục 5, 6)
  kraljicCategory    KraljicCategory?
  profitImpactScore  Int?      // 1-10, nhập tay (MANAGER/ADMIN)
  supplyRiskScore    Int?      // 1-10, nhập tay
  otifScore          Float?    // 0.0 - 100.0, tính tự động hàng tháng
  defectRate         Float?    // % hàng lỗi, tính tự động hàng tháng
  vendorGrade        String?   // "A" | "B" | "C"

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

