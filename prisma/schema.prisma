  @@unique([code, tenantId])
  @@map("vendors")
@@index([tenantId])
}

// ==================== EXPENSES ====================

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String?
  code        String   @unique
  name        String
  accountId   String // tài khoản chi phí (642, 641, 627...)
  account     Account  @relation(fields: [accountId], references: [id])
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@unique([code, tenantId])
  @@map("expense_categories")
@@index([tenantId])
}

model Expense {
  id               String                @id @default(uuid())
  tenantId    String?
  expenseCode      String                @unique // EXP-YYYYMMDD-XXXX
  date             DateTime              @default(now())
  categoryId       String
  category         ExpenseCategory       @relation(fields: [categoryId], references: [id])
  vendorId         String?
  vendor           Vendor?               @relation(fields: [vendorId], references: [id])
  projectId        String?
  project          Project?              @relation("ProjectExpenses", fields: [projectId], references: [id])
  description      String
  amount           Decimal               @db.Decimal(15, 2) // số tiền chưa thuế
  taxRateId        String?
  taxRate          TaxRate?              @relation(fields: [taxRateId], references: [id])
  taxAmount        Decimal               @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal               @db.Decimal(15, 2)
  paymentMethod    PaymentMethod         @default(CASH)
  bankAccountId    String?
  bankAccount      BankAccount?          @relation("ExpensePaidFrom", fields: [bankAccountId], references: [id])
  status           ExpenseStatus         @default(DRAFT)
  invoiceNumber    String? // số hóa đơn đầu vào
  invoiceUrl       String? // ảnh hóa đơn (Cloudinary)
  paidAt           DateTime?
  note             String?
  createdById      String
  createdBy        User                  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?                 @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  isRecurring      Boolean               @default(false)
  recurringRule    String?
  parentTemplateId String?
  sourceType       String?
  sourceId         String?
