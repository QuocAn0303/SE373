// ==================== PHASE 4: CAMPAIGN TRACKING ====================

// Sự kiện mở/click/bounce/hủy đăng ký của 1 recipient trong 1 chiến dịch.
//
// Ghi chú (CRM Phase 4): trước đây model này có `campaignId String` TRẦN (không FK)
// và `recipientId` trỏ nhầm sang `Customer` thay vì `CampaignRecipient` — nên
// 0 dòng nào ghi được mà vẫn "đúng schema". Phase 4 sửa cả 2 quan hệ + thay
// `event String` (tự do) bằng enum `CampaignTrackingEvent`.
model CampaignTracking {
  id          String                 @id @default(uuid())
  tenantId    String?
  campaignId  String
  campaign    CustomerCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // recipientId NULL = sự kiện ở cấp chiến dịch (vd gửi hàng loạt thất bại toàn bộ).
  recipientId String?
  recipient   CampaignRecipient?     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  event       CampaignTrackingEvent
  // userAgent / ip / url đích — chỉ ghi khi cần, không chứa PII
  metadata    Json?
  createdAt   DateTime               @default(now())

  @@index([campaignId, event])
  @@index([recipientId, event])
  @@map("campaign_trackings")
@@index([tenantId])
}

// ==================== AGENT LAYER (v3.0) ====================

enum AgentSessionStatus {
  RUNNING
  WAITING_HUMAN
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepType {
  LLM_CALL
  TOOL_CALL
  HUMAN_GATE
  RENDER_UI
}

enum HumanGateStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model AgentSession {
  id              String             @id @default(uuid())
  sessionCode     String             @unique @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String?
  status          AgentSessionStatus @default(RUNNING)
  intent          String?
  triggerSource   String             @default("USER_CHAT") // USER_CHAT | CRON_JOB | SYSTEM_EVENT
  userMessage     String             @db.Text
  contextSnapshot Json?
  finalResult     Json?
  errorMsg        String?
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  createdAt       DateTime           @default(now())
  steps           AgentStep[]
  humanGates      AgentHumanGate[]
  feedback        AgentFeedback[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([triggerSource])
  @@map("agent_sessions")
}

model AgentStep {
  id          String        @id @default(uuid())
  tenantId    String?
  sessionId   String
  session     AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence    Int
  type        AgentStepType
  toolName    String?
  toolInput   Json?
  toolOutput  Json?
  prompt      String?       @db.Text
  completion  String?       @db.Text
  status      String        @default("PENDING")
  durationMs  Int?
  path        String?       // "fast_path" | "fallback_llm"
  confidence  Float?
  errorMsg    String?
  createdAt   DateTime      @default(now())

  @@index([sessionId, sequence])
  @@index([tenantId])
  @@map("agent_steps")
}

model AgentHumanGate {
  id            String          @id @default(uuid())
  tenantId      String?
  sessionId     String
  session       AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actionType    String
  actionPayload Json
  actionSummary String          @db.Text
  triggerRule   String?
  status        HumanGateStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?           @relation("HumanGateDecider", fields: [decidedById], references: [id])
  decisionNote  String?
  decidedAt     DateTime?
  expiresAt     DateTime
  resultRef     String?
  createdAt     DateTime        @default(now())

  @@index([sessionId])
  @@index([status, expiresAt])
  @@index([tenantId])
  // Truy vấn "đề xuất PO đã duyệt nhưng chưa tạo được PO" (00b §4.2).
  // Ba điều kiện phải khớp CÙNG LÚC — resultRef null một mình không đủ vì
  // các gate loại khác (DATA_REQUEST...) cũng có resultRef null.
  @@index([actionType, status, resultRef])
  @@map("agent_human_gates")
}

model AgentFeedback {
  id          String   @id @default(uuid())
  tenantId    String?
  sessionId   String
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId      String?
  userId      String
  user        User     @relation("AgentFeedbackUser", fields: [userId], references: [id])
  query       String   @db.Text
  response    String   @db.Text
  rating      Boolean  // true = thumb up, false = thumb down
  comment     String?
  path        String?  // "fast_path" | "fallback_llm"
  intent      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([tenantId])
  @@map("agent_feedback")
}

// T13 (docs/aisc26/NIGHT-PROMPT.md §6 T13) — Sổ ghi token LLM.
//
// VÌ SAO: `config/llm.js` đọc `candidates[0].content.parts` và BỎ QUA
// `usageMetadata` ⇒ không biết một luần gọi tốn bao nhiêu token, không biết chi
// phí LLM/tenant, và không đo được "chi phí LLM" như `03-evaluation-protocol.md`
// §5.4 yêu cầu. Đây là bảng GHI TOKEN, không phải bảng quyết định: không model
// nào đọc nó để ra quyết định nhập hàng (xem `01-llm-role.md` §1 — LLM không
// được chạm vào số).
//
// THỎA THUẬN (giữ đúng, không tự đổi):
//   - MỗI lần gọi LLM = 1 dòng, kể cả lần thất bại (succeeded=false) — cần đủ để
//     biết tiền đi không và tiền đi vào việc gì.
//   - `task` là tên tác vụ hằng số (SKU_MATCH / PROPOSAL_EXPLAIN / VENDOR_MESSAGE),
//     KHÔNG tự do: để gom được chi phí theo vai trò LLM.
//   - `promptText`/`responseText` chỉ ghi ở chế độ `record/replay` để tái lập
//     kết quả; KHÔNG dùng để ghi dữ liệu khách hàng thật — đường dẫn `live` chỉ
//     được chạy trên dữ liệu công khai/mô phỏng (hiến pháp §3).
//   - Không có quan hệ tới User: chi phí gắn với TENANT là thứ cần đo, không với
//     người gọi.
model LlmUsageLog {
  id               String   @id @default(uuid())
  tenantId         String? // NULL = lần gọi ngoài tenant context (cron/script); vẫn ghi
  task             String // tác vụ: SKU_MATCH | PROPOSAL_EXPLAIN | VENDOR_MESSAGE
  provider         String // gemini | openai-compatible | local
  model            String
  mode             String // live | record | replay | fallback
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  succeeded        Boolean  @default(false)
  promptText       String?  @db.Text
  responseText     String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("llm_usage_logs")
}


