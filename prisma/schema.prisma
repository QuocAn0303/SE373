  monthlyAmount    Decimal  @db.Decimal(15, 2)
  remainingAmount  Decimal  @db.Decimal(15, 2)
  allocatedMonths  Int      @default(0)
  startDate        DateTime
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE / FULLY_ALLOCATED
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("prepaid_expenses")
@@index([tenantId])
}

// ==================== PURCHASE ORDERS ====================

enum PurchaseStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  ORDERED
  RECEIVED
  PAID
  REJECTED
  CANCELLED
}

model PurchaseOrder {
  id            String         @id @default(uuid())
  tenantId    String?
  poCode        String         @unique // PO-YYYYMMDD-XXXX
  date          DateTime       @default(now())
  vendorId      String
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  status        PurchaseStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)
  subtotal      Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(15, 2)
  total         Decimal        @default(0) @db.Decimal(15, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(15, 2)
  receivedAt    DateTime?
  expectedAt    DateTime?
  submittedAt   DateTime?
  note          String?
  invoiceNumber String?
  createdById   String
  createdBy     User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?          @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items PurchaseItem[]
  debt  Debt?
  grns           GoodsReceiptNote[]     // Phiếu nhập kho từ PO (3-way matching)
  invoiceRecords PurchaseInvoiceRecord[] // Hoá đơn NCC đã nhận để đối soát

  @@index([status])
  @@map("purchase_orders")
@@index([tenantId])
}

model PurchaseItem {
  id              String        @id @default(uuid())
  tenantId    String?
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(15, 2)
  taxRateId       String?
  taxRate         TaxRate?      @relation(fields: [taxRateId], references: [id])
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  subtotal        Decimal       @db.Decimal(15, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_items")
@@index([tenantId])
}

// ==================== PRM: PARTNER & REFERRAL (Quản trị đối tác) ====================

// Loại đối tác. Để tách bốn nhóm vì cách tính hoa hồng và cách đo hiệu quả khác nhau:
// AFFILIATE giới thiệu bán hàng, MARKETING_CHANNEL là kênh quảng cáo trả theo lượt
// mở rộng, REFERRER là khách giới thiệu khách, SALES_AGENT là nhân viên nội bộ.
// Nhóm AFFILIATE và REFERRER mới có `partner_referrals`; nhóm kia đo bằng
// `Customer.referralSource` và chiến dịch, xem `docs/PLAN_PRM_partner_module.md`.
enum PartnerType {
  AFFILIATE
  MARKETING_CHANNEL
  REFERRER
  SALES_AGENT
}

// Cách tính hoa hồng. PERCENT_OF_CLV nhân tỷ lệ với giá trị vòng đời dự báo của
// khách; FIXED_PER_CUSTOMER trả một số tiền cố định cho mỗi khách chuyển đổi.
// Hai cách cùng tồn tại vì chương trình của nhiều đối tác Việt Nam trả theo lần
// giới thiệu, không theo tỷ lệ doanh thu.
enum CommissionType {
  PERCENT_OF_CLV
  FIXED_PER_CUSTOMER
}

model Partner {
  id              String         @id @default(uuid())
  tenantId        String?
  code            String // ĐT-YYYYMM-XXXX
  name            String
  type            PartnerType    @default(AFFILIATE)
  commissionType  CommissionType @default(PERCENT_OF_CLV)
  // Lưu dạng THẬP PHÂN chứ không phải phần trăm số nguyên. Khi trả ra API thì nhân
  // 100 và đặt tên trường là `commissionPercent` cho rõ đơn vị — xem
  // partner.service.js::serialize. Lưu 0,10 nghĩa là 10%, lưu 10 sẽ sai 100 lần.
  commissionRate  Decimal        @default(0) @db.Decimal(12, 2)
  fixedCommission Decimal        @default(0) @db.Decimal(15, 2)
  contactName     String?
  phone           String?
  email           String?
  isActive        Boolean        @default(true)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  referrals PartnerReferral[]

  // Khoá duy nhất theo MÃ chứ không theo tên: tên đối tác có thể trùng (hai cửa
  // hàng cùng tên ở hai tỉnh), mã thì do hệ thống sinh nên không trùng.
  @@unique([code, tenantId])
  @@index([tenantId, isActive])
  @@map("partners")
}

model PartnerReferral {
  id            String    @id @default(uuid())
  tenantId      String?
  partnerId     String
  // FK tới `partners`, xoá đối tác thì mất lượt giới thiệu.
  //
  // onDelete: Cascade là CHỦ ĐÍCH, và phải khớp với migration SQL (hiện ghi
  // `ON DELETE CASCADE`). Không có, Prisma mặc định Restrict: schema nói chặn xoá,
  // DB lại cho xoá — hai nơi trái ý kiến thì `migrate dev` sinh ra diff giả và, tệ
  // hơn, môi trường nào chạy theo schema sẽ chặn xoá trong khi DB thì không.
  //
  // Xoá cứng đối tác vốn đã bị chặn ở tầng nghiệp vụ (xoá mềm đặt `isActive=false`)
  // vì mất lịch sử là mất chứng cứ tính hoa hồng. Cascade chỉ là lưới an toàn cho
  // trường hợp admin xoá thẳng trong DB, và giữ cho hành vi xoá khớp với schema.
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // Hai cột dưới là KHOÁ MỀM: cố tình KHÔNG khai báo @relation.
  //
  // Vì sao: khách hàng trong hệ thống có thể bị xoá mền, còn lượt giới thiệu là
  // chứng từ kinh doanh và không được mất theo khách. Khai báo quan hệ với
  // onDelete: Cascade sẽ xoá lịch sử giới thiệu khi khách bị dọn — mất luôn
  // chứng cứ để tính hoa hồng và đo hiệu quả đối tác. Đánh đổi ngược lại là mất
  // ràng buộc toàn vẹn ở tầng cơ sở dữ liệu, chấp nhận được vì đây là dữ liệu
  // lịch sử chứ không phải dữ liệu đang giao dịch.
  leadId        String?
  customerId    String?
  // Mã lượt giới thiệu trả về cho đối tác, sinh ngẫu nhiên như mã ưu đãi win-back.
  referralCode  String
  referredName  String
  referredPhone String?
  referredEmail String?
  referralDate  DateTime  @default(now())
  converted     Boolean   @default(false)
  convertedAt   DateTime?
  // Giữ nguyên giá trị `Customer.referralSource` tại thời điểm ghi nhận, để truy
  // ngược được dữ liệu cũ đã có trước khi có bảng này.
  sourceSnapshot String?
  createdAt      DateTime  @default(now())

  // Chống gian lận phổ biến nhất trong chương trình giới thiệu: một đối tác báo
  // cùng một số điện thoại nhiều lần để tính hoa hồng. Ràng buộc ở TẦNG DB như
  // `CrmLead.mobileNo` — logic JavaScript không đủ vì import chạy `skipDuplicates`
  // và hai phiên có thể chạy song song.
  // Vẫn cho phép CÙNG một khách đến từ hai đối tác khác nhau (ràng buộc có partnerId).
  @@unique([referralCode])
  @@unique([partnerId, referredPhone])
  @@index([tenantId, partnerId])
  @@index([tenantId, converted])
  @@map("partner_referrals")
}

// ==================== CRM: CHURN ALERT (Win-back automation — Mục 4) ====================

enum ChurnRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChurnAlertStatus {
  PENDING
  TRIGGERED
  RETAINED
  LOST
}

model ChurnAlert {
  id          String           @id @default(uuid())
  tenantId    String?
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  riskLevel   ChurnRiskLevel
  churnScore  Float            // snapshot churnProbability tại thời điểm tạo alert
  voucherCode String?
  promotionId String?
  promotion   Promotion?       @relation(fields: [promotionId], references: [id])
  status      ChurnAlertStatus @default(PENDING)
  expiresAt   DateTime?        // hạn dùng voucher win-back (mặc định +7 ngày)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([customerId])
  @@map("churn_alerts")
  @@index([tenantId])
}

// ==================== SRM: GOODS RECEIPT NOTE (Nhận hàng PO + QC — Mục 6) ====================

enum GrnStatus {
  DRAFT
  QC_PENDING
  QC_DONE
  POSTED // đã ghi nhận vào Inventory, sẵn sàng 3-way matching
}

model GoodsReceiptNote {
  id              String        @id @default(uuid())
  tenantId        String?
  grnCode         String        @unique // GRN-YYYYMMDD-XXXX
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  status          GrnStatus     @default(DRAFT)
  receivedAt      DateTime      @default(now())
  onTime          Boolean?      // so với PurchaseOrder.expectedAt — tính khi POSTED
  createdById     String
  createdBy       User          @relation("GrnCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items GoodsReceiptItem[]

  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipt_notes")
  @@index([tenantId])
}

model GoodsReceiptItem {
  id             String           @id @default(uuid())
  tenantId       String?
  grnId          String
  grn            GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  purchaseItemId String
  purchaseItem   PurchaseItem     @relation(fields: [purchaseItemId], references: [id])
  receivedQty    Int              // tổng nhận
  passQty        Int              @default(0)
  rejectQty      Int              @default(0)
  lotCode        String?
  expiryDate     DateTime?        @db.Date

  @@index([grnId])
  @@index([productId])
  @@map("goods_receipt_items")
  @@index([tenantId])
}

// ==================== SRM: HOÁ ĐƠN NCC + 3-WAY MATCHING (Mục 6.2-6.3) ====================

enum MatchStatus {
  PENDING
  MATCHED
  VARIANCE_HOLD // vượt dung sai ±1% — chặn thanh toán
  APPROVED_OVERRIDE
}

model PurchaseInvoiceRecord {
  id              String        @id @default(uuid())
  tenantId        String?
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber   String
  invoiceAmount   Decimal       @db.Decimal(15, 2)
  invoiceTax      Decimal       @default(0) @db.Decimal(15, 2)
  receivedAt      DateTime      @default(now())
  matchStatus     MatchStatus   @default(PENDING)
  varianceAmount  Decimal?      @db.Decimal(15, 2)
  variancePct     Float?
  matchedAt       DateTime?
  createdById     String?
  createdAt       DateTime      @default(now())

  @@unique([purchaseOrderId, invoiceNumber])
  @@map("purchase_invoice_records")
  @@index([tenantId])
}

// ==================== TAX ====================

model TaxRate {
  id          String   @id @default(uuid())
  tenantId    String?
  code        String // VAT0, VAT5, VAT8, VAT10
  name        String
  rate        Decimal  @db.Decimal(5, 2) // 0, 5, 8, 10 (%)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses      Expense[]
  purchaseItems PurchaseItem[]

  @@unique([code, tenantId])
  @@map("tax_rates")
@@index([tenantId])
}

// ==================== BANK ACCOUNTS ====================

enum BankTxType {
  DEPOSIT // Nộp tiền
  WITHDRAW // Rút tiền
  TRANSFER_IN // Nhận chuyển khoản
  TRANSFER_OUT // Chuyển khoản đi
  FEE // Phí ngân hàng
  INTEREST // Lãi
}

model BankAccount {
  id             String   @id @default(uuid())
  tenantId    String?
  accountNumber  String
  bankName       String
  accountName    String
  accountId      String // FK tới Account.id (loại 112)
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions BankTransaction[]
  expensesPaid Expense[]         @relation("ExpensePaidFrom")
  statements   BankStatement[]

  @@unique([accountNumber, tenantId])
  @@map("bank_accounts")
@@index([tenantId])
}

model BankTransaction {
  id            String      @id @default(uuid())
  tenantId    String?
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime    @default(now())
  type          BankTxType
  amount        Decimal     @db.Decimal(15, 2)
  balanceAfter  Decimal     @db.Decimal(15, 2)
  reference     String? // mã giao dịch ngân hàng
  description   String
  createdById   String?
  createdBy     User?       @relation("BankTxCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([bankAccountId, date])
  @@map("bank_transactions")
@@index([tenantId])
}

// ==================== FISCAL PERIOD ====================

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalPeriod {
  id         String             @id @default(uuid())
  tenantId    String?
  year       Int
  month      Int // 1..12; 0 = năm
  startDate  DateTime
  endDate    DateTime
  status     FiscalPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?              @relation("PeriodClosedBy", fields: [closedById], references: [id])
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  entries JournalEntry[]

  @@unique([tenantId, year, month])
  @@map("fiscal_periods")
@@index([tenantId])
}

// ==================== DEBT ====================

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  CLOSED
  OVERDUE
}

model Debt {
  id         String     @id @default(uuid())
  tenantId    String?
  type       DebtType
  status     DebtStatus @default(OPEN)
  amount     Decimal    @db.Decimal(12, 2)
  paidAmount Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  vendorId      String?
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  orderId       String?        @unique
  order         Order?         @relation(fields: [orderId], references: [id])
  poId          String?        @unique
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])

  payments DebtPayment[]

  @@index([status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, vendorId])
  @@map("debts")
@@index([tenantId])
}

model DebtPayment {
  id          String        @id @default(uuid())
  tenantId    String?
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  note        String?
  paidAt      DateTime      @default(now())
  debtId      String
  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@index([debtId])
  @@map("debt_payments")
@@index([tenantId])
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  ORDER_PENDING_LONG
  PO_PENDING_APPROVAL
  DEBT_OVERDUE
  PAYROLL_DUE
  EXPENSE_PENDING_APPROVAL
  PERIOD_CLOSING_REMINDER
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(uuid())
  tenantId    String?
  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  link      String?
  meta      Json?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleScope Role?

  @@index([userId, isRead])
  @@index([roleScope, isRead])
  @@index([tenantId, userId, isRead, createdAt])
  @@index([tenantId, roleScope, isRead, createdAt])
  humanGateId    String?
  requiresAction Boolean  @default(false)

  @@index([type, createdAt(sort: Desc)])
  @@map("notifications")
@@index([tenantId])
}

// ==================== PROJECT MANAGEMENT ====================

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

model Project {
  id          String        @id @default(uuid())
  tenantId    String?
  code        String
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(15, 2)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  tasks           ProjectTask[]
  members         ProjectMember[]
  expenses        Expense[]        @relation("ProjectExpenses")
  timeEntries     TimeEntry[]
  projectInvoices ProjectInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@map("projects")
@@index([tenantId])
}

model ProjectTask {
  id            String              @id @default(uuid())
  tenantId    String?
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        ProjectTaskStatus   @default(TODO)
  priority      ProjectTaskPriority @default(MEDIUM)
  dueDate       DateTime?
  estimateHours Decimal?            @db.Decimal(8, 2)
  actualHours   Decimal             @default(0) @db.Decimal(8, 2)
  dependsOnId   String?
  dependsOn     ProjectTask?        @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents    ProjectTask[]       @relation("TaskDependency")

  assigneeId String?
  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])

  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@map("project_tasks")
@@index([tenantId])
}

model ProjectMember {
  id        String            @id @default(uuid())
  tenantId    String?
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("ProjectMemberships", fields: [userId], references: [id])
  role      ProjectMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
@@index([tenantId])
}

// ==================== PRODUCTION MANAGEMENT ====================

enum BomStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Bom {
  id            String    @id @default(uuid())
  tenantId    String?
  code          String    @unique
  productId     String
  product       Product   @relation("BomProduct", fields: [productId], references: [id])
  version       String    @default("v1")
  status        BomStatus @default(DRAFT)
  isSubAssembly Boolean   @default(false)
  parentBomId   String?
  parentBom     Bom?      @relation("BomParent", fields: [parentBomId], references: [id])
  childBoms     Bom[]     @relation("BomParent")
  notes         String?

  items      BomItem[]
  workOrders WorkOrder[]
  routings   Routing[]

  createdById String
  createdBy   User   @relation("BomCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("boms")
@@index([tenantId])
}

model BomItem {
  id          String  @id @default(uuid())
  tenantId    String?
  bomId       String
  bom         Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("BomComponent", fields: [componentId], references: [id])
  quantity    Int
  notes       String?

  createdAt DateTime @default(now())

  @@unique([bomId, componentId])
  @@map("bom_items")
@@index([tenantId])
}

model WorkOrder {
  id        String  @id @default(uuid())
  tenantId    String?
  code      String  @unique
  bomId     String
  bom       Bom     @relation(fields: [bomId], references: [id])
  productId String
  product   Product @relation("WorkOrderProduct", fields: [productId], references: [id])

  quantity    Int
  producedQty Int @default(0)

  // Tổng giá vốn nguyên liệu tại thời điểm complete (đơn vị: VND)
  totalCost      Decimal? @db.Decimal(15, 2)
  // Tham chiếu tới bút toán kế toán khi complete
  journalEntryId String?

  status WorkOrderStatus @default(DRAFT)

  warehouseId String
  warehouse   Warehouse @relation("WorkOrderWarehouse", fields: [warehouseId], references: [id])

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  notes String?

  routingId String?
  routing   Routing? @relation(fields: [routingId], references: [id])

  items         WorkOrderItem[]
  qualityChecks QualityCheck[]
  lotTxs        LotTransaction[]

  createdById String
  createdBy   User   @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@index([tenantId, status, createdAt])
  @@map("work_orders")
@@index([tenantId])
}

model WorkOrderItem {
  id          String    @id @default(uuid())
  tenantId    String?
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  componentId String
  component   Product   @relation("WorkOrderComponent", fields: [componentId], references: [id])

  requiredQty Int
  consumedQty Int @default(0)

  createdAt DateTime @default(now())

  @@unique([workOrderId, componentId])
  @@map("work_order_items")
@@index([tenantId])
}

// ==================== WORK CENTER & ROUTING ====================

model WorkCenter {
  id          String   @id @default(uuid())
  tenantId    String?
  code        String
  name        String
  description String?
  capacity    Decimal  @default(8) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operations RoutingOperation[]

  @@unique([code, tenantId])
  @@map("work_centers")
@@index([tenantId])
}

model Routing {
  id        String   @id @default(uuid())
  tenantId    String?
  code      String   @unique
  name      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bomId     String?
  bom       Bom?     @relation(fields: [bomId], references: [id])
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations RoutingOperation[]
  workOrders WorkOrder[]

  @@map("routings")
@@index([tenantId])
}

model RoutingOperation {
  id              String      @id @default(uuid())
  tenantId    String?
  routingId       String
  routing         Routing     @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequence        Int
  name            String
  workCenterId    String?
  workCenter      WorkCenter? @relation(fields: [workCenterId], references: [id])
  durationMinutes Int         @default(60)
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([routingId])
  @@map("routing_operations")
@@index([tenantId])
}

model QualityCheck {
  id          String    @id @default(uuid())
  tenantId    String?
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  checkedById String?
  checkedBy   User?     @relation("QCCheckedBy", fields: [checkedById], references: [id])
  checkedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items QualityCheckItem[]

  @@map("quality_checks")
@@index([tenantId])
}

model QualityCheckItem {
  id             String       @id @default(uuid())
  tenantId    String?
  qualityCheckId String
  qualityCheck   QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)
  name           String
  result         String?
  notes          String?
  createdAt      DateTime     @default(now())

  @@map("quality_check_items")
@@index([tenantId])
}

// ==================== LOT / SERIAL TRACKING ====================

model InventoryLot {
  id          String    @id @default(uuid())
  tenantId    String?
  lotCode     String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0)
  originalQty Int       @default(0)
  unitCost    Decimal?  @db.Decimal(15, 2)
  mfgDate     DateTime? @db.Date
  expDate     DateTime? @db.Date
  poId        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions LotTransaction[]

  @@unique([lotCode, productId, warehouseId])
  @@index([productId])
  @@index([expDate])
  @@index([productId, warehouseId])
  @@map("inventory_lots")
@@index([tenantId])
}

model LotTransaction {
  id          String       @id @default(uuid())
