  @@map("bill_split_items")
@@index([tenantId])
}

// ==================== F&B: KITCHEN DISPLAY SYSTEM (Phase 4) ====================

model KdsStation {
  id          String     @id @default(uuid())
  tenantId    String?
  name        String
  printerId   String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  tickets     KdsTicket[]
  @@map("kds_stations")
@@index([tenantId])
}

model KdsTicket {
  id           String   @id @default(uuid())
  tenantId    String?
  orderItemId  String   @unique
  orderId      String
  stationId    String
  status       String   @default("NEW") // NEW | COOKING | READY | SERVED | RECALLED | VOIDED
  firedAt      DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  prepTimeSec  Int?
  bumpCount    Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  station      KdsStation @relation(fields: [stationId], references: [id])
  // kds.service.js include({ orderItem: { include: { product, modifiers } } }) → cần relation này,
  // nếu thiếu thì PrismaClientValidationError: Unknown field `orderItem` (GET /api/kds/tickets 500)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  @@index([stationId, status])
  @@index([orderId])
  @@map("kds_tickets")
@@index([tenantId])
}

// ==================== F&B: PRINTER ROUTING (Phase 5) ====================

model Printer {
  id             String   @id @default(uuid())
  tenantId    String?
  name           String
  stationId      String?
  connectionType String   @default("BLUETOOTH") // BLUETOOTH | USB | NETWORK
  macAddress     String?
  ipAddress      String?
  paperWidth     Int      @default(58)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  @@map("printers")
@@index([tenantId])
}

