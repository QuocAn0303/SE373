// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Đặc tả §3.2 "Full-text search qua PostgreSQL @@ operator":
  // Prisma KHÔNG hỗ trợ attribute @@fulltext với connector postgresql (chỉ MySQL/MongoDB).
  // Thay vào đây dùng preview feature fullTextSearchPostgres → filter { search: "..." }
  // trong Prisma Client được compile thành `tsvector @@ tsquery` phía PostgreSQL.
  // Apply cho các model search chính: Customer(name/email/phone), Product(name/sku), Vendor(name/taxCode).
  // GIN index (pg_trgm) sẽ được thêm bằng raw SQL khi chạy migration có DB.
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS & AUTH ====================

enum Role {
  SUPER_OMEGA_ULTRA_ADMIN // role chỉ dành cho lê nguyễn quốc an
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT // Kế toán thuê ngoài — chỉ xem sổ sách, không sửa
  CASHIER
  WAREHOUSE
}

// ==================== SUPER_OMEGA_ULTRA_ADMIN ====================

enum SupportSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model SupportAccessSession {
  id        String                @id @default(uuid())
  adminId   String
  admin     User                  @relation("SupportAdmin", fields: [adminId], references: [id])
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  reason    String
  status    SupportSessionStatus  @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // Ai đã thu hồi phiên (nếu bị REVOKED)
  revokedById String?
  revokedBy   User?   @relation("SupportRevoker", fields: [revokedById], references: [id])

  @@index([tenantId])
  @@index([adminId])
  @@index([status, expiresAt])
  @@map("support_access_sessions")
}

// ==================== PERMISSIONS (RBAC) ====================

model Permission {
  key    String   @id
  label  String
  group  String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String   @id @default(uuid())
  role           Role
  permissionKey  String
  permission     Permission @relation(fields: [permissionKey], references: [key])
  isGranted      Boolean    @default(true)

  @@unique([role, permissionKey])
  @@map("role_permissions")
}

// ==================== SUBSCRIPTION PLANS & BILLING ====================

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("VND")
  durationDays Int     @default(30)
  features    Json     @default("{}")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model TenantSubscription {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIAL)
  startDate      DateTime           @default(now())
  endDate        DateTime
  cancelledAt    DateTime?
  autoRenew      Boolean            @default(true)
  note           String?
  createdById    String?
  createdBy      User?              @relation("SubCreatedBy", fields: [createdById], references: [id])
  invoices       SubscriptionInvoice[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([endDate])
  @@map("tenant_subscriptions")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model SubscriptionInvoice {
  id                String           @id @default(uuid())
  invoiceCode       String           @unique
  subscriptionId    String?
  subscription      TenantSubscription? @relation(fields: [subscriptionId], references: [id])
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("VND")
  status            InvoiceStatus   @default(PENDING)
  checkoutSessionId String?         @unique
  dueDate           DateTime
  paidAt            DateTime?
  paidById          String?
  paidBy            User?           @relation("InvoicePaidBy", fields: [paidById], references: [id])
  paymentMethod     String?
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  customerTags CustomerTag[]

  @@map("tenants")

  supportSessions SupportAccessSession[]
  subscriptions    TenantSubscription[]
  invoices         SubscriptionInvoice[]
}

// ==================== ADMIN CRM CAMPAIGNS ====================

enum AdminCampaignStatus {
  DRAFT
  SENDING
  DONE
}

enum AdminCampaignChannel {
  EMAIL
  SMS
}

model AdminCampaign {
  id          String              @id @default(uuid())
  name        String
  channel     AdminCampaignChannel
  targetPlans String[]
  subject     String
  content     String
  status      AdminCampaignStatus  @default(DRAFT)
  sentCount   Int                  @default(0)
  scheduledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  recipients  AdminCampaignRecipient[]

  @@map("admin_campaigns")
}

model AdminCampaignRecipient {
  id         String        @id @default(uuid())
  campaignId String
  campaign   AdminCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  email      String
  fullName   String
  tenantName String?
  status     String        @default("PENDING")
  error      String?
  sentAt     DateTime?

  @@index([campaignId, status])
  @@map("admin_campaign_recipients")
}

model AdminBackup {
  id          String   @id @default(uuid())
  filename    String
  filepath    String
  sizeBytes   BigInt   @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("admin_backups")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  fullName            String
  role                Role       @default(CASHIER)
  isActive            Boolean    @default(true)
  emailVerified       Boolean    @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  registrationStatus  String     @default("PENDING")
  twoFactorSecret     String?
  twoFactorIv         String?
  twoFactorEnabled    Boolean    @default(false)
  tokenVersion        Int        @default(0)
  mustChangePassword  Boolean    @default(false)
  avatar              String?
  phone               String?
  businessTemplate    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // CRM Phase 4 — Sales hierarchy (cây báo cáo).
  // Self-relation: user này báo cáo cho user nào. NULL = trưởng cao nhất.
  // KHÔNG có ON DELETE CASCADE: xoá user phải gỡ quan hệ trước (setReportsTo tự
  // chăm sóc) — nếu cascade, xoá nhầm 1 manager sẽ xoá luôn cả cây bên dưới.
  reportsToId String?
  reportsTo   User?   @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports User[] @relation("UserReportsTo")

  supportSessionsAsAdmin   SupportAccessSession[] @relation("SupportAdmin")
  supportSessionsAsRevoker SupportAccessSession[] @relation("SupportRevoker")

  orders                 Order[]
  inventoryTransactions  InventoryTransaction[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  employee               Employee?
  payments               Payment[]              @relation("PaymentCreatedBy")
  returnsCreated         OrderReturn[]          @relation("ReturnCreatedBy")
  returnsApproved        OrderReturn[]          @relation("ReturnApprovedBy")
  cycleCounts            CycleCount[]           @relation("CycleCountCreatedBy")
  journalEntries         JournalEntry[]         @relation("JournalCreatedBy")
  expenses               Expense[]              @relation("ExpenseCreatedBy")
  expensesApproved       Expense[]              @relation("ExpenseApprovedBy")
  purchaseOrders         PurchaseOrder[]        @relation("PurchaseCreatedBy")
  bankTxs                BankTransaction[]      @relation("BankTxCreatedBy")
  closedPeriods          FiscalPeriod[]         @relation("PeriodClosedBy")
  purchaseOrdersApproved PurchaseOrder[]        @relation("PurchaseApprovedBy")
  debtPayments           DebtPayment[]
  notifications          Notification[]
  customerNotes          CustomerNote[]
  tasksAssigned          CustomerTask[]         @relation("TaskAssignedTo")
  tasksCreated           CustomerTask[]         @relation("TaskCreatedBy")
  segmentsCreated        CustomerSegment[]
  campaignsCreated       CustomerCampaign[]

  projectsCreated      Project[]       @relation("ProjectCreatedBy")
  projectMemberships   ProjectMember[] @relation("ProjectMemberships")
  projectTasksAssigned ProjectTask[]   @relation("ProjectTaskAssignee")
  projectTasksCreated  ProjectTask[]   @relation("ProjectTaskCreatedBy")

  bomsCreated       Bom[]              @relation("BomCreatedBy")
  workOrdersCreated WorkOrder[]        @relation("WorkOrderCreatedBy")
  qualityChecks     QualityCheck[]     @relation("QCCheckedBy")
  timeEntries       TimeEntry[]        @relation("TimeEntryUser")
  savedReports      SavedReport[]      @relation("ReportCreatedBy")
  workflowsCreated  Workflow[]         @relation("WorkflowCreatedBy")
  workflowApprovals WorkflowApproval[] @relation("WorkflowApprover")
  subscriptionCreatedBy   TenantSubscription[]      @relation("SubCreatedBy")
  invoicesPaidBy          SubscriptionInvoice[]      @relation("InvoicePaidBy")
  adminCampaignRecipients AdminCampaignRecipient[]
  storeCreditTxsCreated   StoreCreditTransaction[] @relation("SCTxCreatedBy")
  agentSessions           AgentSession[]
  humanGateDecisions      AgentHumanGate[]   @relation("HumanGateDecider")
  agentFeedback           AgentFeedback[]    @relation("AgentFeedbackUser")
  backupCodes             BackupCode[]
  adminBackups            AdminBackup[]
  internalDocuments       InternalDocument[] @relation("DocumentAuthor")
  grnsCreated             GoodsReceiptNote[] @relation("GrnCreatedBy")
  crmLeadsOwned           CrmLead[]        @relation("CrmLeadOwner")
  crmDealsOwned           CrmDeal[]        @relation("CrmDealOwner")
  crmCommunications       CrmCommunication[]
  chatBindings            ChatBinding[]

  // HERMES Phase 5 — binding phòng ban trực tiếp (song song Employee.departmentId
  // để user chưa có hồ sơ Employee vẫn bị giới hạn dept). NULL = chưa xếp phòng.
  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, reportsToId])
  @@index([departmentId])
  @@map("users")
}

model BackupCode {
  id        String    @id @default(uuid())
  tenantId  String?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([tenantId])
  @@map("backup_codes")
}

// ==================== MULTI-CURRENCY ====================

model Currency {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  symbol    String
  isBase    Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  rates     ExchangeRate[]

  @@map("currencies")
}

model ExchangeRate {
  id         String   @id @default(uuid())
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  rate       Decimal  @db.Decimal(18, 6)
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())

  @@unique([currencyId, date])
  @@index([date(sort: Desc)])
  @@map("exchange_rates")
}

// ==================== COMPANY SETTINGS ====================

model CompanySettings {
  id               String   @id @default(uuid())
  tenantId    String?
  name             String   @default("Công ty của tôi")
  address          String?
  phone            String?
  email            String?
  taxCode          String?
  logo             String?
  industry         String?
  currency         String   @default("VND")
  onboardingDone   Boolean  @default(false)
  onboardingStep   Int      @default(0)
  demoSeeded       Boolean  @default(false)
  beginnerMode     Boolean  @default(true)
  businessTemplate String?
  accountingMode      AccountingMode @default(FULL_VAS)
  poApprovalThreshold Decimal?       @db.Decimal(15, 2)
  // CRM: con trỏ round-robin gán lead từ webhook (Mục 2 — Lead Capture)
  leadRoundRobinCursor Int          @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("company_settings")
@@index([tenantId])
}

// ==================== PRODUCTS ====================

model Category {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  promotions Promotion[]

  @@unique([name, tenantId])
  @@map("categories")
@@index([tenantId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String?
  sku         String
  name        String
  imageUrl    String?
  description String?
  price       Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  unit        String   @default("cái")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  inventories        Inventory[]
  orderItems         OrderItem[]
  stockTransferItems StockTransferItem[]
  cycleCountItems    CycleCountItem[]
  // chiều ngược của RecipeIngredient.ingredientProduct (xem RecipeIngredient)
  recipeIngredients  RecipeIngredient[]
  purchaseItems      PurchaseItem[]
  promotions         Promotion[]
  returnLineItems    ReturnLineItem[]

  trackByLot    Boolean @default(false)
  trackBySerial Boolean @default(false)
  shelfLifeDays Int?

  // F&B: loại product (REGULAR / COMBO / VARIANT_PARENT)
  productType     ProductType @default(REGULAR)
  // F&B: ga tới station nào (Bếp chính / Bar / Trà sữa) — null = mặc định
  kdsStationId    String?
  modifierGroups  ModifierGroup[]
  variants        ProductVariant[]
  combo           Combo?
  comboItems      ComboItem[]
  recipe          Recipe?

  bomsAsProduct             Bom[]                @relation("BomProduct")
  bomItemsAsComponent       BomItem[]            @relation("BomComponent")
  workOrdersAsProduct       WorkOrder[]          @relation("WorkOrderProduct")
  workOrderItemsAsComponent WorkOrderItem[]      @relation("WorkOrderComponent")
  inventoryLots             InventoryLot[]
  marketplaceListings       MarketplaceListing[]
  routings                  Routing[]
  serialNumbers             SerialNumber[]
  goodsReceiptItems         GoodsReceiptItem[]
  crmDealItems              CrmDealItem[]

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@unique([sku, tenantId])
  @@index([tenantId, isActive, createdAt])
  @@map("products")
@@index([tenantId])
}

// ==================== INVENTORY & WAREHOUSES ====================

model Warehouse {
  id        String   @id @default(uuid())
  tenantId    String?
  code      String   @unique
  name      String
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventories   Inventory[]
  orders        Order[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  workOrders    WorkOrder[]     @relation("WorkOrderWarehouse")
  inventoryLots InventoryLot[]
  serialNumbers SerialNumber[]
  grns          GoodsReceiptNote[]

  @@unique([code, tenantId])
  @@map("warehouses")
@@index([tenantId])
}

model Inventory {
  id        String   @id @default(uuid())
  tenantId    String?
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  minStock  Int      @default(10)
  updatedAt DateTime @updatedAt

  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  transactions InventoryTransaction[]

  @@unique([productId, warehouseId])
  @@map("inventories")
@@index([tenantId])
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String              @id @default(uuid())
  tenantId    String?
  transferCode    String              @unique
  status          StockTransferStatus @default(PENDING)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  note            String?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  items           StockTransferItem[]

  @@index([tenantId, status, createdAt])
  @@map("stock_transfers")
@@index([tenantId])
}

model StockTransferItem {
  id         String        @id @default(uuid())
  tenantId    String?
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
@@index([tenantId])
}

enum TransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
  RESERVATION
  RESERVATION_RELEASE
}

model InventoryTransaction {
  id        String          @id @default(uuid())
  tenantId    String?
  type      TransactionType
  quantity  Int
  note      String?
  unitCost  Decimal?        @db.Decimal(15, 2)
  createdAt DateTime        @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt(sort: Desc)])
  @@map("inventory_transactions")
@@index([tenantId])
}

// ==================== CUSTOMERS ====================

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum CustomerNoteType {
  NOTE
  CALL
  EMAIL
  MEETING
  ZALO
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// CRM: trạng thái lead từ webhook đa kênh
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CUSTOMER
  DEAD
}

// ===== CRM SALES PIPELINE (Lead / Deal / Organization / Contact) =====

enum CrmEntityType {
  LEAD
  DEAL
}

enum CrmStageKind {
  ONGOING
  WON
  LOST
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DEAD
}

enum CrmCommType {
  NOTE
  CALL
  EMAIL
  MEETING
  ZALO
  WHATSAPP
  SYSTEM
}

enum CrmCommDirection {
  INBOUND
  OUTBOUND
}

model Customer {
  id            String       @id @default(uuid())
  tenantId    String?
  name          String
  phone         String?
  email         String?
  address       String?
  taxCode       String?
  totalSpent    Decimal      @default(0) @db.Decimal(12, 2)
  totalDebt     Decimal      @default(0) @db.Decimal(12, 2)
  creditLimit   Decimal      @default(0) @db.Decimal(12, 2)
  storeCredit   Decimal      @default(0) @db.Decimal(12, 2)
  tier          CustomerTier @default(BRONZE)
  loyaltyPoints Int          @default(0)
  // CRM: lead capture (Mục 2)
  leadStatus         LeadStatus? @default(NEW)
  // Nguồn giới thiệu dạng VĂN BẢN tự do — giữ lại để dữ liệu cũ không mất hiệu
  // lực. Từ khi có phân hệ PRM, nguồn có bản chuẩn hoá nằm ở `PartnerReferral`
  // và liên kết qua `partnerReferralId` bên dưới. `referralSource` vẫn được ghi
  // để báo cáo R-10 (nhóm theo nguồn) không phải đổi câu truy vấn.
  referralSource     String?
  zaloUserId         String?
  // PRM: khoá mềm tới lượt giới thiệu (không khai báo @relation — xem PartnerReferral)
  partnerReferralId  String?
  // PRM: chi phí đã trả cho nguồn để có được khách này. Cho phép NULL vì nhiều
  // khách đến tự nhiên; báo cáo lợi nhuận ròng đối tác dùng `commissionRate`
  // của đối tác, còn cột này dành cho ngân sách CAC do chủ doanh nghiệp tự nhập.
  acquiredCost       Decimal?    @db.Decimal(15, 2)

  // CRM: RFM động — tính lại bởi hook/cron sau mỗi đơn COMPLETED (Mục 3)
  rfmRecencyDays     Int?
  rfmFrequency       Int?
  rfmMonetary        Decimal?  @db.Decimal(15, 2)
  rfmSegment         String?   // Champions | Loyal | Potential | At-Risk | Hibernating
  rfmScoredAt        DateTime?

  // CRM: dự báo CLV (BG/NBD + Gamma-Gamma) & churn probability (Mục 3.3)
  clvPredicted       Decimal?  @db.Decimal(15, 2)
  churnProbability   Float?    // 0.00 - 1.00
  clvScoredAt        DateTime?

  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders             Order[]
  debts              Debt[]
  promotionUsages    PromotionUsage[]
  loyaltyTxs         LoyaltyTransaction[]
  stampCards         StampCard[]
  notes              CustomerNote[]
  tags               CustomerTagOnCustomer[]
  tasks              CustomerTask[]
  campaignRecipients CampaignRecipient[]
  projectInvoices    ProjectInvoice[]
  portalSessions     PortalSession[]
  storeCreditTxs     StoreCreditTransaction[]
  churnAlerts        ChurnAlert[]
  crmContacts        CrmContact[]
  crmDeals           CrmDeal[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@unique([phone, tenantId])
  @@index([tenantId, createdAt])
  @@map("customers")
@@index([tenantId])
}

model CustomerNote {
  id          String           @id @default(uuid())
  tenantId    String?
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content     String           @db.Text
  type        CustomerNoteType @default(NOTE)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([customerId, createdAt])
  @@map("customer_notes")
@@index([tenantId])
}

model CustomerTag {
  id        String                  @id @default(uuid())
  name      String                  // Đã bỏ @unique ở đây
  color     String                  @default("#0f766e")
  category  String                  @default("GENERAL") // Nguồn gốc, hành vi, sở thích....
  
  tenantId  String?                 // Bắt buộc phải có để biết tag này của shop nào
  tenant    Tenant?                 @relation(fields: [tenantId], references: [id])
  
  createdAt DateTime                @default(now())
  customers CustomerTagOnCustomer[]

  @@unique([name, tenantId])        // Tên tag chỉ cần duy nhất trong phạm vi 1 Tenant
  @@index([tenantId])
  @@map("customer_tags")
}

model CustomerTagOnCustomer {
  tenantId    String?

  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@id([customerId, tagId])
  @@map("customer_tag_on_customer")
@@index([tenantId])
}

model CustomerTask {
  id           String       @id @default(uuid())
  tenantId    String?
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  assignedToId String
  assignedTo   User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([customerId])
  @@map("customer_tasks")
@@index([tenantId])
}

model CustomerSegment {
  id            String   @id @default(uuid())
  tenantId    String?
  name          String
  description   String?
  rules         Json
  customerCount Int      @default(0)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns CustomerCampaign[]

  @@unique([name, tenantId])
  @@map("customer_segments")
@@index([tenantId])
}

// ===== CRM SALES PIPELINE (Lead / Deal / Organization / Contact) =====
// Thêm mới, không thay đổi Customer hiện có. Customer vẫn là khách hàng giao dịch
// (đơn/công nợ/loyalty); CrmDeal.customerId chỉ được set khi deal thắng.

model CrmPipelineStage {
  id          String       @id @default(uuid())
  tenantId    String?
  entityType  CrmEntityType
  label       String
  color       String       @default("#0f766e")
  sortOrder   Int          @default(0)
  kind        CrmStageKind @default(ONGOING)
  probability Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  leads CrmLead[]
  deals CrmDeal[]

  @@unique([tenantId, entityType, label])
  @@index([tenantId, entityType, sortOrder])
  @@map("crm_pipeline_stages")
@@index([tenantId])
}

model CrmLead {
  id              String        @id @default(uuid())
  tenantId        String?
  leadName        String
  email           String?
  mobileNo        String?
  jobTitle        String?
  source          String?
  status          CrmLeadStatus @default(NEW)
  stageId         String?
  stage           CrmPipelineStage? @relation(fields: [stageId], references: [id])
  leadOwnerId     String?
  leadOwner       User?         @relation("CrmLeadOwner", fields: [leadOwnerId], references: [id])
  organizationId  String?
  organization    CrmOrganization? @relation(fields: [organizationId], references: [id])
  contactId       String?
  contact         CrmContact?   @relation(fields: [contactId], references: [id])
  expectedValue   Decimal?      @db.Decimal(15, 2)
  convertedAt     DateTime?
  // Con trỏ denormalize để hiển thị nhanh; quan hệ thật là CrmDeal.leadId
  convertedDealId String?
  lastContactedAt DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deals CrmDeal[]

  communications CrmCommunication[]

  @@index([tenantId, status, stageId])
  @@index([tenantId, mobileNo])
  @@index([tenantId, leadOwnerId])
  // CRM audit H10: chống lead trùng ở TẦNG DB, không chỉ bằng logic JS.
  // `importList` dùng `skipDuplicates: true` — vốn là no-op khi không có @@unique.
  // Postgres coi NULL khác nhau ⇒ lead không có SĐT/email vẫn tạo được vô hạn.
  @@unique([mobileNo, tenantId])
  @@unique([email, tenantId])
  @@map("crm_leads")
@@index([tenantId])
}

model CrmOrganization {
  id            String   @id @default(uuid())
  tenantId      String?
  name          String
  website       String?
  industry      String?
  annualRevenue Decimal? @db.Decimal(18, 2)
  taxCode       String?
  phone         String?
  address       String?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts CrmContact[]
  leads    CrmLead[]
  deals    CrmDeal[]

  @@unique([name, tenantId])
  @@map("crm_organizations")
@@index([tenantId])
}

model CrmContact {
  id             String   @id @default(uuid())
  tenantId       String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean  @default(false)
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads    CrmLead[]
  deals    CrmDeal[]

  communications CrmCommunication[]

  @@index([tenantId, organizationId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("crm_contacts")
@@index([tenantId])
}

model CrmDeal {
  id                String   @id @default(uuid())
  tenantId          String?
  dealName          String
  organizationId    String?
  organization      CrmOrganization? @relation(fields: [organizationId], references: [id])
  contactId         String?
  contact           CrmContact? @relation(fields: [contactId], references: [id])
  leadId            String?
  lead              CrmLead?  @relation(fields: [leadId], references: [id])
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  stageId           String?
  stage             CrmPipelineStage? @relation(fields: [stageId], references: [id])
  kind              CrmStageKind @default(ONGOING)
  value             Decimal  @default(0) @db.Decimal(15, 2)
  currency          String   @default("VND")
  probability       Int      @default(0)
  expectedCloseDate DateTime?
  nextStep          String?
  dealOwnerId       String?
  dealOwner         User?    @relation("CrmDealOwner", fields: [dealOwnerId], references: [id])
  closedAt          DateTime?
  lostReason        String?
  // @unique: 1 deal chỉ sinh tối đa 1 đơn hàng — ràng buộc cứng ở tầng DB
  orderId           String?   @unique
  order             Order?    @relation(fields: [orderId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items CrmDealItem[]

  communications CrmCommunication[]

  @@index([tenantId, stageId, kind])
  @@index([tenantId, dealOwnerId])
  @@index([tenantId, expectedCloseDate])
  @@map("crm_deals")
@@index([tenantId])
}

model CrmDealItem {
  id          String   @id @default(uuid())
  tenantId    String?
  dealId      String
  deal        CrmDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(15, 2)
  amount      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  @@index([dealId])
  @@map("crm_deal_items")
@@index([tenantId])
}

model CrmCommunication {
  id          String   @id @default(uuid())
  tenantId    String?
  type        CrmCommType
  direction   CrmCommDirection?
  subject     String?
  content     String   @db.Text
  durationSec Int?
  // Cột đã tồn tại từ migration Phase 1; khai báo relation ở đây để Prisma select
  // được lead/deal/contact (hiển thị tên trên timeline) — cột KHÔNG đổi tên.
  leadId        String?
  lead          CrmLead?   @relation(fields: [leadId], references: [id])
  dealId        String?
  deal          CrmDeal?   @relation(fields: [dealId], references: [id])
  contactId     String?
  contact       CrmContact? @relation(fields: [contactId], references: [id])
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, dealId, createdAt])
  @@map("crm_communications")
@@index([tenantId])
}

enum CampaignChannel {
  EMAIL
  ZALO
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

// Sự kiện theo dõi chiến dịch (CRM Phase 4 — mở/click/bounce/hủy đăng ký)
enum CampaignTrackingEvent {
  SENT
  OPEN
  CLICK
  BOUNCE
  UNSUBSCRIBE
}

model CustomerCampaign {
  id           String          @id @default(uuid())
  tenantId    String?
  name         String
  channel      CampaignChannel
  segmentId    String
  segment      CustomerSegment @relation(fields: [segmentId], references: [id])
  subject      String?
  bodyTemplate String          @db.Text
  status       CampaignStatus  @default(DRAFT)
  scheduledAt  DateTime?
  sentAt       DateTime?
  stats        Json?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  recipients CampaignRecipient[]
  trackings  CampaignTracking[]

  @@index([status, scheduledAt])
  @@map("customer_campaigns")
@@index([tenantId])
}

model CampaignRecipient {
  id         String           @id @default(uuid())
  tenantId    String?
  campaignId String
  campaign   CustomerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  status     RecipientStatus  @default(PENDING)
  error      String?
  sentAt     DateTime?

  // CRM Phase 4 — tuân thủ Nghị định 13/2023 (marketing bắt buộc có đường từ chối)
  // consentedAt: thời điểm khách đồng ý nhận tin. NULL = chưa ghi nhận consent.
  consentedAt       DateTime?
  // unsubscribedAt: khách đã bấm "từ chối". NOT NULL ⇒ executeCampaign bỏ qua vĩnh viễn.
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  // 2 token ngẫu nhiên (không đoán được, không chứa PII) sinh lúc gửi:
  //  - unsubscribeToken → link từ chối + header List-Unsubscribe
  //  - trackingToken    → pixel mở mail + link bấm
  // Tách riêng để link tracking không vô tình là link từ chối (và ngược lại).
  unsubscribeToken  String?   @unique
  trackingToken     String?   @unique

  trackings CampaignTracking[]

  @@index([campaignId, status])
  // CRM audit H11: index này ĐÃ có trong DB (migration 20261001120000) nhưng schema
  // không khai báo ⇒ `prisma migrate dev` đề xuất DROP index trên bảng campaign.
  // Truy vấn `executeCampaign` lọc `unsubscribedAt IS NULL` theo campaignId nên nó
  // là index chạy thật, không phải index thừa.
  @@index([campaignId, unsubscribedAt])
  @@map("campaign_recipients")
@@index([tenantId])
}

model LoyaltyTransaction {
  id         String    @id @default(uuid())
  tenantId    String?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  points     Int
  type       String
  orderId    String?
  note       String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
@@index([tenantId])
}

// ==================== STORE CREDIT ====================

model StoreCreditTransaction {
  id          String    @id @default(uuid())
  tenantId    String?
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(12, 2)
  type        String    // EARN | SPEND | ADJUST | REFUND
  referenceId String?   // orderId / returnId / adjustment reason
  note        String?
  createdById String
  createdBy   User      @relation("SCTxCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([customerId, createdAt(sort: Desc)])
  @@map("store_credit_transactions")
@@index([tenantId])
}

// ==================== ORDERS ====================

enum OrderStatus {
  PENDING // chờ xử lý
  CONFIRMED // xác nhận
  SHIPPING // đang giao
  COMPLETED // hoàn thành
  CANCELLED // hủy
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOMO
  VNPAY
  ZALOPAY
  PAYOS
  VIETQR
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
  STORE_CREDIT
  EXCHANGE
  NONE
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_CHANGE
  EXPIRED
  OTHER
}

model Order {
  id                String        @id @default(uuid())
  tenantId    String?
  orderCode         String        @unique
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(CASH)
  paymentStatus     PaymentStatus @default(UNPAID)
  subtotal          Decimal       @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  discountType      String?       @default("NONE")
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  promotionDiscount Decimal       @default(0) @db.Decimal(12, 2)
  voucherCode       String?
  loyaltyDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyPointsUsed Int           @default(0)
  total             Decimal       @db.Decimal(12, 2)
  currency          String        @default("VND")
  exchangeRate      Decimal       @default(1) @db.Decimal(18, 6)
  note              String?
  // F&B: loại đơn, bàn, service charge, tip, kênh
  orderType         OrderType     @default(DINE_IN)
  tableId           String?
  tableSessionId    String?
  seatNumber        Int?
  serviceChargePercent Decimal    @default(0) @db.Decimal(5, 2)
  tipAmount         Decimal       @default(0) @db.Decimal(12, 2)
  splitMode         String?       // ITEM | EVEN | CUSTOM
  channel           String        @default("POS") // POS | QR | GRABFOOD | SHAPEFOOD | BEFOOD
  channelOrderId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items             OrderItem[]
  payments          Payment[]
  returns           OrderReturn[]
  debt              Debt?
  promotionUsages   PromotionUsage[]
  billSplits        BillSplit[]
  invoice           Invoice?
  delivery          Delivery?
  electronicInvoice ElectronicInvoice?
  serialNumbers     SerialNumber[]
  crmDeal           CrmDeal?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("orders")
@@index([tenantId])
}

model Invoice {
  id          String    @id @default(uuid())
  tenantId    String?
  invoiceCode String    @unique
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  pdfUrl      String?
  taxCode     String?
  companyName String?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("invoices")
@@index([tenantId])
}

model ElectronicInvoice {
  id           String   @id @default(uuid())
  tenantId    String?
  invoiceNo    String   @unique
  orderId      String?  @unique
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  templateCode String   @default("1/001")
  serial       String   @default("K24TVE")
  issueDate    DateTime @default(now())
  buyerName    String
  buyerTaxCode String?
  buyerAddress String?
  signedXml    String?  @db.Text
  pdfUrl       String?
  cqtCode      String?
  cqtStatus    String   @default("PENDING") // PENDING/SIGNED/SENT/ACCEPTED/REJECTED/CANCELLED
  provider     String   @default("VNPT") // VNPT/VIETTEL/FPT
  rawResponse  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cqtStatus])
  @@map("electronic_invoices")
@@index([tenantId])
}

enum DeliveryProvider {
  GHTK
  GHN
  VNPOST
  VIETTEL_POST
  J_T
  SELF
  OTHER
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Delivery {
  id               String           @id @default(uuid())
  tenantId    String?
  orderId          String           @unique
  order            Order            @relation(fields: [orderId], references: [id])
  provider         DeliveryProvider
  trackingCode     String?
  shippingFee      Decimal          @default(0) @db.Decimal(12, 2)
  status           DeliveryStatus   @default(PENDING)
  recipientName    String
  recipientPhone   String
  recipientAddress String
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failedReason     String?
  note             String?
  events           DeliveryEvent[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("deliveries")
@@index([tenantId])
}

model DeliveryEvent {
  id         String         @id @default(uuid())
  tenantId    String?
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  location   String?
  note       String?
  occurredAt DateTime
  createdAt  DateTime       @default(now())

  @@index([deliveryId])
  @@map("delivery_events")
@@index([tenantId])
}

model OrderItem {
  id             String  @id @default(uuid())
  tenantId    String?
  quantity       Int
  price          Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  discountType   String? @default("NONE")
  discountValue  Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  // F&B: lần gọi (course), trạng thái bếp, lý do hủy, combo cha
  courseId           Int     @default(1)
  status             String  @default("PENDING") // PENDING | FIRED | SERVED | VOIDED
  voidReason         String?
  comboId            String?
  parentOrderItemId  String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  returnItems  ReturnLineItem[]
  modifiers   OrderItemModifier[]
  // F&B: ticket bếp gắn với 1 order item (kds_tickets.orderItemId là @unique → quan hệ 1-1)
  kdsTicket    KdsTicket?

  @@index([orderId])
  @@index([productId])
  @@index([tenantId, orderId])
  @@map("order_items")
@@index([tenantId])
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String?
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("VND")
  exchangeRate  Decimal       @default(1) @db.Decimal(18, 6)
  method        PaymentMethod
  reference     String?
  note          String?
  // Payment gateway fields (merged từ PaymentTransaction)
  provider      String?       // MOMO | VNPAY | ZALOPAY | PAYOS | VIETQR | CASH | BANK_TRANSFER | CARD
  providerTxId  String?       @unique
  txStatus      String?       // PENDING | SUCCESS | FAILED | REFUNDED | PARTIAL_REFUND
  rawResponse   Json?
  refundedAmount Decimal      @default(0) @db.Decimal(12, 2)
  createdById   String
  createdBy     User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([orderId, createdAt(sort: Desc)])
  @@index([provider, txStatus])
  @@index([tenantId, orderId])
  @@map("payments")
  @@index([tenantId])
}

model OrderReturn {
  id            String            @id @default(uuid())
  tenantId    String?
  returnCode    String            @unique
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  status        ReturnStatus      @default(PENDING)
  reason        ReturnReason
  restockable   Boolean           @default(true)
  refundMethod  RefundMethod      @default(CASH)
  refundAmount  Decimal           @db.Decimal(12, 2)
  completedAt   DateTime?
  note          String?
  createdById   String
  createdBy     User              @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?             @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lineItems     ReturnLineItem[]

  @@map("order_returns")
  @@index([tenantId])
}

enum LineItemType {
  RETURN
  EXCHANGE
}

model ReturnLineItem {
  id           String      @id @default(uuid())
  tenantId     String?
  type         LineItemType @default(RETURN)
  returnId     String
  return       OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId  String?
  orderItem    OrderItem?  @relation(fields: [orderItemId], references: [id])
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal     @default(0) @db.Decimal(12, 2)
  subtotal     Decimal     @default(0) @db.Decimal(12, 2)
  refundAmount Decimal     @default(0) @db.Decimal(12, 2)

  @@index([returnId])
  @@map("return_line_items")
  @@index([tenantId])
}

// ==================== PROMOTIONS ====================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  CATEGORY_DISCOUNT
  PRODUCT_DISCOUNT
  FREE_SHIPPING
  HAPPY_HOUR
}

enum ScheduleType {
  ALWAYS
  CRON
}

enum PromotionScope {
  AUTO
  VOUCHER_CODE
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

model Promotion {
  id            String           @id @default(uuid())
  tenantId      String?
  code          String?
  name          String
  description   String?
  type          PromotionType
  scope         PromotionScope   @default(AUTO)
  status        PromotionStatus  @default(DRAFT)
  value         Decimal          @db.Decimal(12, 2)
  maxDiscount   Decimal?         @db.Decimal(12, 2)
  minOrderValue Decimal?         @db.Decimal(12, 2)
  minQuantity   Int?
  buyQuantity   Int?
  getQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usageCount    Int              @default(0)
  perUserLimit  Int?
  // Happy Hour fields (merged từ HappyHourRule)
  scheduleType  ScheduleType?    @default(ALWAYS)
  cronExpression String?
  daysOfWeek    String?          // "1,2,3,4,5,6,7" (1=CN)
  startTime     String?          // "HH:mm"
  endTime       String?          // "HH:mm"
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  customerTier  CustomerTier?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  usages        PromotionUsage[]
  churnAlerts   ChurnAlert[]

  @@index([status, startDate, endDate])
  @@unique([code, tenantId])
  @@map("promotions")
  @@index([tenantId])
}

model PromotionUsage {
  id            String    @id @default(uuid())
  tenantId    String?
  discountValue Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id])
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@index([promotionId, customerId])
  @@index([orderId])
  @@map("promotion_usages")
@@index([tenantId])
}

enum CycleCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CycleCount {
  id          String           @id @default(uuid())
  tenantId    String?
  code        String           @unique
  status      CycleCountStatus @default(DRAFT)
  note        String?
  createdById String
  createdBy   User             @relation("CycleCountCreatedBy", fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CycleCountItem[]

  @@map("cycle_counts")
@@index([tenantId])
}

model CycleCountItem {
  id             String     @id @default(uuid())
  tenantId    String?
  cycleCountId   String
  cycleCount     CycleCount @relation(fields: [cycleCountId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  warehouseId    String?
  systemQuantity Int
  actualQuantity Int?
  variance       Int?
  note           String?

  @@index([cycleCountId])
  @@map("cycle_count_items")
@@index([tenantId])
@@index([productId, warehouseId])
}

// Lưu refresh token để support refresh / logout
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  tenantId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("refresh_tokens")
}

// Audit log / activity trail
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String? // có thể null cho hệ thống
  action     String // ví dụ: CREATE_ORDER, UPDATE_PRODUCT
  entity     String // ví dụ: Order, Product, Inventory
  entityId   String? // id của entity liên quan
  beforeJson Json? // trạng thái trước khi thay đổi
  afterJson  Json? // trạng thái sau khi thay đổi
  meta       Json? // thông tin bổ sung (ip, note ...)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  agentSessionId String?
  agentStepId    String?

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ==================== HR / PAYROLL ====================

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ViolationType {
  LATE
  EARLY
  PACKING_ERROR
  DAMAGED_GOODS
  UNAUTHORIZED_ABSENCE
}

model Employee {
  id                  String    @id @default(uuid())
  tenantId    String?
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  employeeCode        String?   @unique
  phone               String?
  position            String    @default("OTHER")
  hireDate            DateTime?
  address             String?
  baseSalary          Decimal   @default(5000000) @db.Decimal(12, 2)
  shiftMoney          Decimal   @default(0) @db.Decimal(12, 2)
  dependents          Int       @default(0)
  socialInsuranceCode String?
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shifts     Shift[]
  violations Violation[]
  payrolls   Payroll[]
  overtimeRequests OvertimeRequest[]

  @@map("employees")
@@index([tenantId])
}

model Shift {
  id         String    @id @default(uuid())
  tenantId    String?
  date       DateTime
  type       ShiftType
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([employeeId, date])
  @@map("shifts")
@@index([tenantId])
}

model Violation {
  id         String        @id @default(uuid())
  tenantId    String?
  type       ViolationType
  note       String?
  penalty    Decimal?      @default(0) @db.Decimal(12, 2)
  date       DateTime      @default(now())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  createdAt  DateTime      @default(now())

  @@index([employeeId, date])
  @@map("violations")
@@index([tenantId])
}

model OvertimeRequest {
  id            String   @id @default(uuid())
  tenantId    String?
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  hours         Decimal  @db.Decimal(5, 2)
  rate          Float    @default(1.5)
  amount        Decimal  @db.Decimal(12, 2)
  reason        String?
  status        String   @default("PENDING") // PENDING/APPROVED/REJECTED
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, date])
  @@map("overtime_requests")
@@index([tenantId])
}

model Payroll {
  id                    String   @id @default(uuid())
  tenantId    String?
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id])
  month                 Int
  year                  Int
  baseSalary            Decimal  @db.Decimal(12, 2)
  shiftMoney            Decimal  @default(0) @db.Decimal(12, 2)
  shiftCount            Int
  attendanceCoefficient Float
  penalties             Decimal  @db.Decimal(12, 2)
  finalSalary           Decimal  @db.Decimal(12, 2)
  bhxhEmployee          Decimal  @default(0) @db.Decimal(12, 2)
  pitAmount             Decimal  @default(0) @db.Decimal(12, 2)
  isLocked              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([employeeId, month, year])
  @@map("payrolls")
@@index([tenantId])
}

// ==================== ACCOUNTING ====================

enum AccountType {
  ASSET // Tài sản
  LIABILITY // Nợ phải trả
  EQUITY // Vốn chủ sở hữu
  REVENUE // Doanh thu
  EXPENSE // Chi phí
  COST_OF_GOODS_SOLD // Giá vốn hàng bán
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// Hệ thống tài khoản (Chart of Accounts) theo VAS rút gọn
model Account {
  id            String        @id @default(uuid())
  code          String        @unique // 111, 131, 511, 632...
  name          String
  nameVi        String // Tên thân thiện cho founder
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  parent        Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]     @relation("AccountTree")
  description   String?
  isCash        Boolean       @default(false) // dùng để tính cash flow
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines             JournalLine[]
  expenseCategories ExpenseCategory[]
  workCenters       WorkCenter[]

  @@index([type])
  @@map("accounts")
}

enum JournalSource {
  MANUAL
  ORDER
  PAYMENT
  RETURN
  PURCHASE
  EXPENSE
  PAYROLL
  INVENTORY
  BANK
  ADJUSTMENT
  OPENING_BALANCE
  DEBT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id             String         @id @default(uuid())
  tenantId    String?
  entryCode      String         @unique // JE-YYYYMMDD-XXXX
  date           DateTime       @default(now())
  source         JournalSource  @default(MANUAL)
  sourceId       String? // id của Order/Payment/Expense...
  // Sub-event code để phân biệt nhiều bút toán cho cùng sourceId.
  // Ví dụ: source=EXPENSE, sourceId=<expense.id> có thể có operation='ACCRUAL' và 'PAYMENT'.
  // source=ORDER thường chỉ có operation='PRIMARY' (mặc định).
  operation      String         @default("PRIMARY")
  description    String
  status         JournalStatus  @default(POSTED)
  reversedById   String?
  reversedBy     JournalEntry?  @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals      JournalEntry[] @relation("JournalReversal")
  createdById    String?
  createdBy      User?          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          JournalLine[]

  // Chỉ áp dụng unique khi sourceId không null (MANUAL không có sourceId).
  // Postgres treat NULL trong composite key là khác nhau → an toàn cho MANUAL.
  @@unique([source, sourceId, operation], name: "uniq_je_source_op")
  @@index([source, sourceId])
  @@index([date])
  @@index([tenantId, date])
  @@index([tenantId, status, date])
  @@map("journal_entries")
@@index([tenantId])
}

// Outbox: khi auto-post bút toán thất bại (CoA missing, period closed,
// entryCode collision, ...), thay vì nuốt lỗi và để kế toán lệch, chúng ta
// lưu lại payload + lỗi để retry sau (cron hoặc admin trigger).
model JournalPostingError {
  id              String        @id @default(uuid())
  tenantId    String?
  source          JournalSource
  sourceId        String?
  payload         Json // input đã chuẩn bị cho postEntry
  errorMsg        String
  retryCount      Int           @default(0)
  lastTriedAt     DateTime?
  resolvedAt      DateTime? // null = chưa xử lý; có giá trị = đã retry thành công hoặc admin đánh dấu bỏ qua
  resolvedEntryId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([source, sourceId])
  @@index([resolvedAt])
  @@map("journal_posting_errors")
@@index([tenantId])
}

model JournalLine {
  id          String       @id @default(uuid())
  tenantId    String?
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(15, 2)
  credit      Decimal      @default(0) @db.Decimal(15, 2)
  description String?
  // tham chiếu phụ (optional) để filter sub-ledger
  partyType   String? // "CUSTOMER" | "VENDOR" | "EMPLOYEE"
  partyId     String?

  @@index([accountId])
  @@index([entryId])
  @@index([partyType, partyId])
  @@map("journal_lines")
@@index([tenantId])
}

// ==================== BANK RECONCILIATION ====================

model BankStatement {
  id            String              @id @default(uuid())
  tenantId    String?
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  fileName      String?
  importedAt    DateTime            @default(now())
  fromDate      DateTime?
  toDate        DateTime?
  lineCount     Int                 @default(0)
  status        String              @default("IMPORTED") // IMPORTED / RECONCILED
  lines         BankStatementLine[]

  @@index([bankAccountId])
  @@map("bank_statements")
@@index([tenantId])
}

model BankStatementLine {
  id             String        @id @default(uuid())
  tenantId    String?
  statementId    String
  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  txDate         DateTime
  description    String
  debit          Decimal       @default(0) @db.Decimal(15, 2)
  credit         Decimal       @default(0) @db.Decimal(15, 2)
  balance        Decimal?      @db.Decimal(15, 2)
  reference      String?
  matchedEntryId String? // FK → JournalEntry.id (nullable until matched)
  isMatched      Boolean       @default(false)
  isAdjustment   Boolean       @default(false)

  @@index([statementId, isMatched])
  @@map("bank_statement_lines")
@@index([tenantId])
}

// ==================== FIXED ASSETS ====================

model FixedAssetCategory {
  id            String   @id @default(uuid())
  tenantId    String?
  code          String   @unique
  name          String
  accountId     String // TK 211/213...
  deprAccountId String // TK 214
  expAccountId  String // TK 6427/6421...
  lifeMonths    Int      @default(60)
  method        String   @default("STRAIGHT_LINE")
  createdAt     DateTime @default(now())

  assets FixedAsset[]

  @@map("fixed_asset_categories")
@@index([tenantId])
}

model FixedAsset {
  id                      String             @id @default(uuid())
  tenantId    String?
  code          String
  name          String
  categoryId              String
  category                FixedAssetCategory @relation(fields: [categoryId], references: [id])
  purchaseDate            DateTime
  cost                    Decimal            @db.Decimal(15, 2)
  salvageValue            Decimal            @default(0) @db.Decimal(15, 2)
  lifeMonths              Int
  method                  String             @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(15, 2)
  status                  String             @default("ACTIVE") // ACTIVE/DISPOSED/FULLY_DEPRECIATED
