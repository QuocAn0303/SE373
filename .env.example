# Server
PORT=3000
NODE_ENV=development

# M6: Chỉ set =true khi chạy SAU reverse proxy (nginx/caddy).
# Mặc định tắt — tránh spoof X-Forwarded-For làm bypass rate limit khi deploy trực tiếp.
# TRUST_PROXY=true

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:cc@localhost:5432/erp_db?schema=public"
# JWT
JWT_SECRET=
# Access token ngắn hạn (1h mặc định) — frontend tự refresh qua cookie httpOnly
JWT_EXPIRES_IN=15m

# CORS / Frontend
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Gốc URL dựng link trong email marketing (CRM Phase 4).
# Dùng cho: link từ chối nhận tin, pixel đo mở mail, link bấm có đo.
# PHẢI là domain PUBLIC khi deploy production — nếu để mặc định localhost thì
# link từ chối trong email gửi cho khách sẽ không mở được ⇒ vi phạm
# Nghị định 13/2023. `npm run verify` sẽ cảnh báo nếu còn trỏ localhost.
# Bỏ trống thì fallback sang CLIENT_URL (đúng khi nginx/Vite proxy /api về backend).
TRACKING_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10

# Hạn mức riêng cho endpoint tracking CRM (/api/crm/track/*: pixel mở mail, link
# bấm, từ chối nhận tin). KHÔNG dùng chung RATE_LIMIT_MAX vì pixel + link của một
# chiến dịch lớn đều đến từ cùng IP mail client/gateway → đủ để chặn nhầm và làm
# mất số liệu OPEN/CLICK. Đơn vị: số request/phút. Mặc định 2000.
TRACKING_RATE_LIMIT=2000

# Redis (Socket.IO adapter) — đặt password khi deploy. REDIS_URL app đọc từ đây.
# Nếu để trống → redis chạy không auth (chỉ nên dùng dev).
# REDIS_PASSWORD=

# Backup tự động hàng ngày 02:00 — thư mục lưu (mặc định ./backups)
# BACKUP_DIR=./backups
# ⚠️ File backup được mã hóa AES-256-GCM (envelope: mỗi file 1 DEK, DEK wrap bằng
# ENCRYPTION_KEY) bằng ENCRYPTION_KEY (xem bên dưới).
# Mất ENCRYPTION_KEY = không thể restore backup + không giải mã được 2FA secret.

# Bcrypt (L1: cost 12 — hash cũ cost 10 vẫn verify được)
BCRYPT_ROUNDS=12

# Encryption key cho IntegrationConfig (≥ 32 ký tự ngẫu nhiên).
# BẮT BUỘC set ở production (thiếu → app từ chối khởi động mã hóa).
# ⚠️ Key quyết định khả năng giải mã: nếu đổi key (hoặc fallback derive từ
# JWT_SECRET mà JWT_SECRET bị đổi) → 2FA secret + integration secrets trong DB
# sẽ KHÔNG giải mã được. Tạo: node -e "require('crypto').randomBytes(32).toString('hex')"
# ENCRYPTION_KEY=

# (Tùy chọn) Khóa cũ khi rotate ENCRYPTION_KEY — dùng để giải mã backup/2FA/integration
# secrets đã mã hóa bằng khóa cũ. Backup mới luôn dùng ENCRYPTION_KEY (khóa mới).
# ENCRYPTION_KEY_PREVIOUS=

# ============================================================
# LLM cloud cho AI agent (src/config/llm.js). Bỏ trống → dùng model local
# (cần Python + transformers/peft/bitsandbytes, nặng và chậm).
# LLM_PROVIDER=gemini dùng Google AI Studio; đổi sang gateway OpenAI-compatible
# thì đặt thêm LLM_BASE_URL.
# ============================================================
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_TIMEOUT_MS=60000

# ============================================================
# Các biến dưới (Cloudinary, SMTP, VNPT, SMS) đã có UI cấu hình:
# vào /integrations (cần ADMIN). Giá trị trong UI ưu tiên hơn .env.
# ============================================================

# VNPT E-Invoice
VNPT_EINVOICE_URL=
VNPT_USERNAME=
VNPT_PASSWORD=
VNPT_COM_CODE=
VNPT_TEMPLATE_CODE=1/001
VNPT_SERIAL=K24TVE

# SMS gateway (ESMS / TWILIO / LOG)
SMS_PROVIDER=LOG
SMS_API_KEY=
SMS_API_SECRET=
SMS_BRAND_NAME=AduuERP

#tự điền dô như .env nha 
#Cloudinary
CLOUDINARY_CLOUD_NAME=tên_cloud
CLOUDINARY_API_KEY=mã_api_key
CLOUDINARY_API_SECRET=mã_api_secret
# Ollama (AI local)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma2:9b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Company / Invoice
COMPANY_NAME=Mini ERP Store
COMPANY_ADDRESS=123 Đường ABC, Quận 1, TP.HCM
COMPANY_TAX_ID=0123456789
INVOICE_VAT_RATE=10

# Loyalty
LOYALTY_POINTS_PER_1000=1
LOYALTY_REDEEM_POINTS=100
LOYALTY_REDEEM_VALUE=10000

# Delivery webhook — BẮT BUỘC set ở production (thiếu → webhook bị từ chối, tránh đơn DELIVERED giả)
# GHTK: chữ ký HMAC-SHA256 (header X-GHTK-Signature) trên raw body
GHTK_WEBHOOK_SECRET=
# GHN: token trong header "Token"
GHN_WEBHOOK_SECRET=
# VNPOST / ViettelPost / J&T: token chung (header Authorization: Bearer <token> hoặc X-Webhook-Token)
DELIVERY_WEBHOOK_SECRET=

# VietQR webhook bảo mật — BẮT BUỘC ở production (nếu thiếu → webhook bị từ chối, tránh thanh toán giả)
# Casso: secret dùng để verify chữ ký HMAC-SHA256 (header X-Casso-Signature) — lấy từ Casso app
CASSO_WEBHOOK_SECRET=
# SePay: token dùng để verify header Authorization: Bearer <token> — cấu hình trong app SePay
SEPAY_WEBHOOK_TOKEN=

# Web Push (PWA) — KHÔNG BẮT BUỘC. Hệ thống tự sinh VAPID keys và lưu vào DB
# (mã hóa) khi chạy lần đầu — chủ shop không cần cấu hình. Chỉ set nếu muốn override:
# Tạo keys tại: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@aduu-erp.com

# Email (invoice + CRM campaigns)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mini ERP Store <no-reply@yourdomain.com>"

# CRM — Zalo Official Account (Phase 4 campaigns)
# Lấy access_token tại: https://developers.zalo.me/createapp (Official Account)
ZALO_OA_ACCESS_TOKEN=
# Optional: override Zalo API endpoint
# ZALO_OA_API_URL=https://openapi.zalo.me/v3.0/oa/message/cs

# Sentry (error tracking)
SENTRY_DSN=

# ── Bổ sung nhập (replenishment) ──────────────────────────────────────────────
# Tự động sinh đề xuất PO khi tồn thấp. MẶC ĐỊNH OFF.
# Bật lên cũng CHỈ tạo human-gate (PURCHASE_ORDER_PROPOSAL), KHÔNG tự tạo PO —
# PO chỉ được tạo khi có người duyệt. Bật/tắt đều an toàn.
AUTO_REORDER_PROPOSAL=false

# Debounce (ms) cho CDC bắt sự kiện tồn kho xuống dưới ngưỡng.
CDC_LOW_STOCK_DEBOUNCE_MS=60000

# ── HERMES agent ops (Telegram ChatOps + LLM UIT) ─────────────────────────
# Kênh chat pilot: Telegram Bot API (tạo bot qua @BotFather).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=candora_ops_bot
# BẮT BUỘC ở production: webhook PUBLIC, thiếu secret ⇒ hệ thống TỪ CHỐI (503).
# Secret này phải trùng với `secret_token` khi đặt webhook.
# TELEGRAM_WEBHOOK_SECRET=
# Hạn mức webhook (request/phút/IP). 30 là đủ cho burst hợp lệ, chặn được dò OTP.
# TELEGRAM_RATE_LIMIT=30
# LLM UIT (mạng trường/VPN): Gemma điều phối/tác vụ nhanh, Qwen suy luận đa bước.
# Ngoài mạng trường → fallback Gemini free (LLM_PROVIDER=gemini).
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://llm.uit.edu.vn/gemma/v1
# LLM_MODEL=gemma-4-26b
# LLM_API_KEY=
# LLM_REASONING_BASE_URL=https://llm.uit.edu.vn/qwen/v1
# LLM_REASONING_MODEL=qwen3.8-27b
# LLM_REASONING_API_KEY=
# Cho phép LLM đọc dữ liệu thật (chỉ bật cho tenant mô phỏng CANDORA).
# LLM_ALLOW_REAL_DATA=1
# LLM_DATA_TAG=mophong